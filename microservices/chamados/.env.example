# Copie este arquivo para .env antes de iniciar o serviço.
# Use o mesmo segredo JWT dos serviços Usuários e Inventário.
JWT_SEGREDO=

# Endereços dos serviços na rede Docker compartilhada.
USUARIOS_URL=http://usuarios:8000
INVENTARIO_URL=http://inventario:8000
TIMEOUT_SERVICOS_SEGUNDOS=2

# Credenciais exclusivas do banco deste microserviço.
POSTGRES_USER=chamados
POSTGRES_PASSWORD=senha-local-chamados
POSTGRES_DB=chamados_db
